{
  "packageRules": [
    {
      "matchFileNames": ["Dockerfile"],
      "matchDatasources": ["apk"],
      "registryUrls": [
        "https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=x86_64"
      ]
    }
  ],
  "customManagers": [
    {
      "description": "Update APK packages in Dockerfile RUN statements (HEREDOC and traditional)",
      "customType": "regex",
      "fileMatch": ["^Dockerfile$", "^Dockerfile\\.[^/]*$"],
      "matchStringsStrategy": "recursive",
      
      "matchStrings": [
        "RUN\\s+(?:<<[A-Z]+\\s+(?:bash|sh)?\\s*)?apk\\s+add[^\\n\\\\]*(?:\\\\[^\\S\\n]*\\n[^\\n\\\\]*)*",
        "(?<depName>[a-z0-9][a-z0-9._+-]*)=(?<currentValue>\\d+[^\\s\\\\]+)"
      ],
      
      "datasourceTemplate": "apk",
      "versioningTemplate": "apk"
    }
  ]
}
