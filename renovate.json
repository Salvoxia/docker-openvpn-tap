{
  "packageRules": [
    {
      "matchFileNames": ["Dockerfile"],
      "matchDatasources": ["apk"],
      "registryUrls": [
        "https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=x86_64"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)Dockerfile$"],
      "matchStrings": [
        "\\bapk add\\b[\\s\\S]*?\\s(?<depName>[a-zA-Z0-9_-]+)=(?<currentValue>[0-9][a-zA-Z0-9.-]+)"
      ],
      "datasourceTemplate": "repology",
      "depNameTemplate": "alpine_3_24/{{{depName}}}",
      "versioningTemplate": "loose"
    }
  ]
}
