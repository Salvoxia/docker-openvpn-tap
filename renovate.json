{
  "packageRules": [
    {
      "matchFileNames": ["Dockerfile"],
      "matchDatasources": ["apk"],
      "registryUrls": [
        "https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=x86_64"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)Dockerfile$"],
      "matchStringsStrategy": "nested",
      "matchStrings": [
        "FROM alpine:(?<alpineVer>[0-9]+\\.[0-9]+)(?:@[a-zA-Z0-9:]+)?(?<remainingContent>[\\s\\S]*)",
        "(?:apk add|\\s)(?<depName>[a-zA-Z0-9_-]+)=(?<currentValue>[0-9][a-zA-Z0-9.-]+)"
      ],
      "datasourceTemplate": "repology",
      "depNameTemplate": "alpine_{{replace '.' '_' alpineVer}}/{{depName}}",
      "versioningTemplate": "loose"
    }
  ]
}
